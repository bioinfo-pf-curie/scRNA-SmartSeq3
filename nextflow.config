/*
 * -------------------------------------------------
 *  Nextflow config file
 * -------------------------------------------------
 * Default config options for all environments.
 */

manifest {
  name = 'scRNA-full-length'
  description = 'Nextflow pipeline for Flashseq/SmartSeq3 data analysis'
  homePage = 'https://gitlab.curie.fr/sc-platform/smartseq3'
  author = 'L. Hadj Abed, N. Servant'
  version = '3.0.0'
  mainScript = 'main.nf'
  nextflowVersion = '>=19.10.0'
}

/**********
 * Params *
 **********/

plugins {
  id 'nf-boost'
}

if (params.cleanup == "auto"){ 
  boost.cleanup = true
  boost.cleanupInterval = '180s'
}

params {
  saveIntermediates = false
  cleanup = 'auto' // [none, auto, success]

  help = false
  name = "scRNA-full-length"

  // Analysis parameters
  genome = null
  reads = null
  readDir = null
  samplePlan = null
  singleEnd = false

  //bioname
  sampleDescription=null

  chunkSize = 50
  //if not one repo per batch you can generate your batch thanks to sampleDescription
  generateBatch=false

  protocol = 'flashseq' // or smartseq3 or liveseq

  // star alignement
  starDefaultOpts = "--outFilterMultimapNmax 1 --limitSjdbInsertNsj 2000000 --outFilterIntronMotifs RemoveNoncanonicalUnannotated --outSAMtype BAM SortedByCoordinate --outSAMunmapped Within"
  starOpts = false
  starTwoPass = false
  minStarReads = 100
  // filtering
  mapq = 20
  rmSingleton = false
  keepDups = false
  // featureCounts
  featurecountsOpts = null

  minReads=500 // min number of final reads to concider a cell

  barcodeTag='RG'
  umiTag='BX'

  // Design TSO for cutadapt
  umi_size=8
  tag_umitools = protocol == 'flashseq'  ? 'GAGT' : 
                protocol == 'smartseq3' ? 'AATG' : 
                protocol == 'liveseq'   ? 'GAGT'   : '' 

  tag_cutadapt = protocol == 'flashseq'  ? 'AAGCAGTGGTATCAACGCAGAGT' : 
                protocol == 'smartseq3' ? 'AGAGACAGATTGCGCAATG' : 
                protocol == 'liveseq'   ? 'AAGCAGTGGTATCAACGCAGAGT'   : '' 

  primerT = protocol == 'flashseq'  ? 'AAGCAGTGGTATCAACGCAGAGTAC' :
            protocol == 'smartseq3' ? 'ACGAGCATCAGCAGCATACGA'   :
            protocol == 'liveseq'   ? 'AATGATACGGCGACCACCGATCG'   : ''

  // Skips
  skipMultiQC = false
  skipGeneBodyCovPlot = true
  //skipSatCurvePlot = false

  // Output directories
  // Output directories
  multiqcConfig = "$projectDir/assets/multiqcConfig.yaml"
  metadata = "$projectDir/assets/metadata.tsv"
  outDir = "$launchDir/results"
  summaryDir = "${params.outDir}/summary"
  tmpDir = './'

}

/************************
 * Configs and profiles *
 ************************/

// Additional configs
includeConfig 'conf/base.config'
includeConfig 'conf/process.config'
includeConfig 'conf/geniac.config'

// Profiles

profiles {
  conda {
    includeConfig 'conf/conda.config'
  }
  multiconda {
    includeConfig 'conf/multiconda.config'
  }
  apptainer {
    includeConfig 'conf/apptainer.config'
  }
  docker {
    includeConfig 'conf/docker.config'
  }
  singularity {
    includeConfig 'conf/singularity.config'
  }
  path {
    includeConfig 'conf/path.config'
  }
  multipath {
    includeConfig 'conf/multipath.config'
  }
  podman {
    includeConfig 'conf/podman.config'
  }
  cluster {
    includeConfig 'conf/cluster.config'
  }
  test{
    includeConfig 'conf/test.config'
  }
}

// Annotation paths
includeConfig 'conf/genomes.config'
