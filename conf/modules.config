/*
 * Define modules options
 */


process {

  // Default
  publishDir = [
    path: { "${params.outDir}/${task.process.tokenize(':')[-1].tokenize('_')[0]}" },
    mode: 'copy',
    saveAs: { filename -> filename.equals('versions.txt') ? null : filename }
  ]

  withName: 'umiExtraction' {
    publishDir = [
      [
        path: { "${params.outDir}/umiExtraction" },
        mode: 'copy',
        pattern: "*Bowtie2.log"
      ],
      [
        path: { "${params.outDir}/umiExtraction" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.txt') ? null : filename }
      ]
    ]
    ext.args = '-extract-method=regex --bc-pattern='(?P<discard_1>.*CGCAGAGT)(?P<umi_1>.{$params.umi_size})(?P<discard_2>GGG).*' \\'
  }

  withName:'getSoftwareVersions' {
    publishDir = [
      path: { "${params.outDir}/softwareVersions" },
      mode: 'copy'
    ]
  }

  withName:'outputDocumentation' {
    publishDir = [
      path: { "${params.summaryDir}" },
      mode: 'copy'
    ]
  }
}