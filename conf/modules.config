/*
 * Define modules options
 */


process {

  /*withName: 'umiExtract*' {
    publishDir = [
      [
        path: { "${params.outDir}/umiExtract" },
        mode: 'copy',
        pattern: "*.log"
      ]
    ]
    ext.args = { 
      params.protocol == "flashseq" ? "--extract-method=regex --bc-pattern='(?P<discard_1>.*CGCAGAGT)(?P<umi_1>.{$params.umi_size})(?P<discard_2>GGG).*'" : "--extract-method=regex --bc-pattern='(?P<discard_1>.*TGCGCAATG)(?P<umi_1>.{$params.umi_size})(?P<discard_2>GGG).*'"
    }
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_part${meta.chunk}" : "${meta.id}" }
  }

  withName: 'seqkitSeq' {
    ext.args = "--name"
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_part${meta.chunk}" : "${meta.id}" }
  }

  withName: 'cutadapt' {
    ext.args = {[
      params.protocol == "flashseq" ? "-g A{30}GTACTCTGCGTTGATACCACTGCTT -g A{20}GTACTCTGCGTTGATACCACTGCTT -g A{15}GTACTCTGCGTTGATACCACTGCTT" : "",
      params.protocol == "flashseq" ? "-G A{30}GTACTCTGCGTTGATACCACTGCTT -G A{20}GTACTCTGCGTTGATACCACTGCTT -G A{15}GTACTCTGCGTTGATACCACTGCTT" : "",
      params.protocol == "smartseq3"  ? "-a A{30}TCGTATGCTGCT -a A{20}TCGTATGCTGCT" : "",
      params.protocol == "smartseq3" ? "-A A{30}TCGTATGCTGCT -A A{20}TCGTATGCTGCT" : "",
      params.protocol == "flashseq" ? "-g AAGCAGTGGTATCAACGCAGAGTACT{30} -g AAGCAGTGGTATCAACGCAGAGTACT{20} -g AAGCAGTGGTATCAACGCAGAGTACT{15}" : "-g ATCAGCAGCATACGAT{30} -g ATCAGCAGCATACGAT{20}",
      params.protocol == "flashseq" ? "-G AAGCAGTGGTATCAACGCAGAGTACT{30} -G AAGCAGTGGTATCAACGCAGAGTACT{20} -G AAGCAGTGGTATCAACGCAGAGTACT{15}" : "-G ATCAGCAGCATACGAT{30} -G ATCAGCAGCATACGAT{20}",
      "--minimum-length=20"
    ].join(' ').trim() }
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_part${meta.chunk}" : "${meta.id}" }
  }

  withName: 'starAlign' {
    publishDir = [
      [
        path: { "${params.outDir}/bam" },
        mode: 'copy',
        pattern: "*out"
      ]
    ]
    ext.args = '--outFilterMultimapNmax 1 --limitSjdbInsertNsj 2000000 --outFilterIntronMotifs RemoveNoncanonicalUnannotated --outSAMtype BAM SortedByCoordinate --outSAMunmapped Within'
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_part${meta.chunk}" : "${meta.id}" }
  }

  withName: 'samtoolsStats'{
    ext.prefix = { "${bam.baseName}" }
  }

  withName: 'samtoolsFilter' {
    publishDir = [
      path: { "${params.outDir}/filtering" },
      mode: 'copy',
      pattern: "*.bam"
    ]
    ext.prefix = { "${meta.id}" }
    // Singleton == one of the two reads is unmapped
    // -F remove : 0x004=unmapped, 0x0008=mate unmapped, 0x0400=PCR dup
    // -f keep : 0x001=read paired
    ext.args = [
      params.rmSingleton ? "-F 0x004 -F 0x0008 -f 0x001" : "-F 0x004", 
      params.keepDups ? "" : "-F 0x0400",
      params.mapq > 0 ? "-q ${params.mapq}" : ""
    ].join(' ').trim()
  }

  withName: 'samtoolsIndexFilter' {
    publishDir = [
      path: { "${params.outDir}/filtering" },
      mode: 'copy',
      pattern: "*.bai"
    ]
  }

  withName: 'featureCounts' {
    ext.args = "-R BAM -g gene_name"
    ext.prefix = { "${meta.id}_counts" }
  }*/

  withName:'getSoftwareVersions' {
    publishDir = [
      path: { "${params.outDir}/softwareVersions" },
      mode: 'copy'
    ]
  }

  withName:'outputDocumentation' {
    publishDir = [
      path: { "${params.summaryDir}" },
      mode: 'copy'
    ]
  }

}