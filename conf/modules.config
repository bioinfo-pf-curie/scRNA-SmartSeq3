/*
 * Define modules options
 */


process {

  withName: 'umiExtract*' {
    publishDir = [
      [
        path: { "${params.outDir}/umiExtract" },
        mode: 'copy',
        pattern: "*.log"
      ]
    ]
    ext.args = { 
      params.protocol == "flashseq" ? "--extract-method=regex --bc-pattern='(?P<discard_1>.*AGAGT)(?P<umi_1>.{$params.umi_size})(?P<discard_2>GG).*'" : "--extract-method=regex --bc-pattern='(?P<discard_1>.*GCAATG)(?P<umi_1>.{$params.umi_size})(?P<discard_2>GG).*'"
    }
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_chunk${meta.chunk}" : "${meta.id}" } // ça ne marche pas car pour le test ${meta.part}==1 mais retourne qd mm le cas "part"
  }

  withName: 'concatFastq' {
    publishDir = [
      [
        path: { "${params.outDir}/concatFastq" },
        mode: 'copy',
        pattern: "*.log"
      ]
    ]
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_chunk${meta.chunk}" : "${meta.id}" } // ça ne marche pas car pour le test ${meta.part}==1 mais retourne qd mm le cas "part"
  }

  /*withName: 'seqkitSeq' {
    ext.args = "--name"
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_chunk${meta.chunk}" : "${meta.id}" }
  }*/

  withName: 'cutadapt' {
    publishDir = [
      [
        path: { "${params.outDir}/cutadapt" },
        mode: 'copy',
        pattern: "*log"
      ],
      [
        path: { "${params.outDir}/cutadapt" },
        mode: 'copy',
        pattern: "*fastq.gz",
      ]
    ]
    ext.args = {[
      params.protocol == "flashseq" ? "-g A{30}GTACTCTGCGTTGATACCACTGCTT -g A{20}GTACTCTGCGTTGATACCACTGCTT -g A{15}GTACTCTGCGTTGATACCACTGCTT" : "",
      params.protocol == "flashseq" ? "-G A{30}GTACTCTGCGTTGATACCACTGCTT -G A{20}GTACTCTGCGTTGATACCACTGCTT -G A{15}GTACTCTGCGTTGATACCACTGCTT" : "",
      params.protocol == "smartseq3"  ? "-a A{30}TCGTATGCTGCT -a A{20}TCGTATGCTGCT" : "",
      params.protocol == "smartseq3" ? "-A A{30}TCGTATGCTGCT -A A{20}TCGTATGCTGCT" : "",
      params.protocol == "flashseq" ? "-g AAGCAGTGGTATCAACGCAGAGTACT{30} -g AAGCAGTGGTATCAACGCAGAGTACT{20} -g AAGCAGTGGTATCAACGCAGAGTACT{15}" : "-g ATCAGCAGCATACGAT{30} -g ATCAGCAGCATACGAT{20}",
      params.protocol == "flashseq" ? "-G AAGCAGTGGTATCAACGCAGAGTACT{30} -G AAGCAGTGGTATCAACGCAGAGTACT{20} -G AAGCAGTGGTATCAACGCAGAGTACT{15}" : "-G ATCAGCAGCATACGAT{30} -G ATCAGCAGCATACGAT{20}",
      "--minimum-length=20"
    ].join(' ').trim() }
    ext.prefix = { "${meta.part}" > 1 ? "${meta.id}_${meta.umi}_chunk${meta.chunk}" : "${meta.id}_${meta.umi}" }
  }

  withName: 'starAlign' {
    publishDir = [
      [
        path: { "${params.outDir}/bam" },
        mode: 'copy',
        pattern: "*out"
      ]
    ]
    ext.args = '--outFilterMultimapNmax 1 --limitSjdbInsertNsj 2000000 --outFilterIntronMotifs RemoveNoncanonicalUnannotated --outSAMtype BAM SortedByCoordinate --outSAMunmapped Within'
    ext.prefix = { "${meta.part} > 1" ? "${meta.id}_${meta.umi}_chunk${meta.chunk}" : "${meta.id}_${meta.umi}" }
  }

  withName: 'samtoolsMerge'{
    ext.prefix = { "${meta.id}_${meta.umi}"  }
  }

  withName: 'samtoolsStats'{
    ext.prefix = { "${meta.id}_${meta.umi}"  }
  }

  withName: 'filterUnaligned' {
    publishDir = [
      path: { "${params.outDir}/filtering/unaligned" },
      mode: 'copy',
      pattern: "*.bam"
    ]
    ext.prefix = {"${meta.id}_${meta.umi}" }
    // Singleton == one of the two reads is unmapped
    // -F remove 0x004=unmapped, 0x0008=mate unmapped
    // -f keep 0x001=read paired
    ext.args = [
      params.rmSingleton ? "-F 0x004 -F 0x0008 -f 0x001" : "-F 0x004",
      params.mapq > 0 ? "-q ${params.mapq}" : ""
    ].join(' ').trim()
  }

  withName: 'samtoolsIndexFilterUnaligned'{
    ext.prefix = { "${meta.id}_${meta.umi}"  }
  }

  /* Umi part *************************/
  withName: 'featureCountsUmis' {
    publishDir = [
      [
        path: { "${params.outDir}/umi/featureCounts" },
        mode: 'copy',
        pattern: "*.bam"
      ],
      [
        path: { "${params.outDir}/umi/featureCounts" },
        mode: 'copy',
        pattern: "*.log"
      ],
      [
        path: { "${params.outDir}/umi/featureCounts" },
        mode: 'copy',
        pattern: "*.csv"
      ],
      [
        path: { "${params.outDir}/umi/featureCounts" },
        mode: 'copy',
        pattern: "*.summary"
      ]
    ]
    ext.args = "-R BAM -g gene_name"
    ext.prefix = { "${meta.id}_${meta.umi}" }
  }

  withName: 'umiCount' {
    publishDir = [
      [
      path: { "${params.outDir}/umi/matrix" },
      mode: 'copy',
      pattern: "*.tsv.gz"
      ],
      [
        path: { "${params.outDir}/umi/matrix" },
        mode: 'copy',
        pattern: "*.log"
      ]
    ]
    ext.args = "--method=cluster --per-gene --gene-tag=XT --assigned-status-tag=XS"
    ext.prefix = { "${meta.id}_${meta.umi}" }
  }

  /* Non Umi part ********************/
  /*withName: 'filterMarkdup' {
    publishDir = [
      path: { "${params.outDir}/filtering/pcrDup" },
      mode: 'copy',
      pattern: "*.bam"
    ]
    ext.prefix = { "${meta.id}_${meta.umi}" }
    // -F remove 0x0400=PCR dup
    ext.args = [
      params.keepDups ? "" : "-F 0x0400",
    ].join(' ').trim()
  }
  */


  withName:'getSoftwareVersions' {
    publishDir = [
      path: { "${params.outDir}/softwareVersions" },
      mode: 'copy'
    ]
  }

  withName:'outputDocumentation' {
    publishDir = [
      path: { "${params.summaryDir}" },
      mode: 'copy'
    ]
  }

}