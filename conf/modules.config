/*
 * Define modules options
 */


process {

  withName: 'umiExtraction' {
    publishDir = [
      [
        path: { "${params.outDir}/umiExtraction" },
        mode: 'copy',
        pattern: "*.fastq.gz"
      ],
      [
        path: { "${params.outDir}/umiExtraction" },
        mode: 'copy',
        pattern: "*.log"
      ],
      [
        path: { "${params.outDir}/umiExtraction" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.txt') ? null : filename }
      ]
    ]
    ext.args = params.protocol == "flashseq" ? "-extract-method=regex --bc-pattern='(?P<discard_1>.*CGCAGAGT)(?P<umi_1>.${params.umi_size})(?P<discard_2>GGG).*'" : 
    "-extract-method=regex --bc-pattern='(?P<discard_1>.*TGCGCAATG)(?P<umi_1>.${params.umi_size})(?P<discard_2>GGG).*'"
  }

  withName: 'umiExtractionSummary' {
    publishDir = [
      [
        path: { "${params.outDir}/umiExtractionSummary" },
        mode: 'copy',
        pattern: "*.fastq.gz"
      ],
      [
        path: { "${params.outDir}/umiExtractionSummary" },
        mode: 'copy',
        pattern: "*.txt"
      ]
    ]
  }

  withName:'getSoftwareVersions' {
    publishDir = [
      path: { "${params.outDir}/softwareVersions" },
      mode: 'copy'
    ]
  }

  withName:'outputDocumentation' {
    publishDir = [
      path: { "${params.summaryDir}" },
      mode: 'copy'
    ]
  }

}